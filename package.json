{
  "name": "@opentritium/dsh-codex-shim",
  "version": "0.1.0",
  "description": "Route-aware Codex environment simulation for DeepSeek Harness, improving tool-call reliability for GPT and other Codex-adapted models",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTritium/dsh-codex-shim.git"
  },
  "files": [
    "lib/",
    "patches/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./gate": {
      "types": "./lib/gate.d.mts",
      "default": "./lib/gate.mjs"
    },
    "./tool-exec": {
      "types": "./lib/tool-exec.d.mts",
      "default": "./lib/tool-exec.mjs"
    },
    "./tool-plan": {
      "types": "./lib/tool-plan.d.mts",
      "default": "./lib/tool-plan.mjs"
    },
    "./tool-web": {
      "types": "./lib/tool-web.d.mts",
      "default": "./lib/tool-web.mjs"
    },
    "./apply-patch": {
      "types": "./lib/apply-patch.d.mts",
      "default": "./lib/apply-patch.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "bench": "vitest bench tests/performance.bench.ts",
    "format": "oxfmt --write src tests \"src/**/*.css\" package.json tsconfig.json tsdown.config.ts oxlint.json .oxfmtrc.json",
    "format:check": "oxfmt --check src tests \"src/**/*.css\" package.json tsconfig.json tsdown.config.ts oxlint.json .oxfmtrc.json",
    "lint": "oxlint --config oxlint.json src tests",
    "lint:fix": "oxlint --config oxlint.json --fix src tests",
    "check": "oxfmt --check src tests \"src/**/*.css\" package.json tsconfig.json tsdown.config.ts oxlint.json .oxfmtrc.json && oxlint --config oxlint.json src tests && tsc --noEmit -p tsconfig.json && vitest run tests && tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "1.32.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-tool": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-attachment",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  }
}
