{
  "name": "@opentritium/dsh-codex-shim",
  "version": "0.1.0",
  "description": "Codex-compatible tools and route-aware prompt surface for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTritium/dsh-codex-shim.git"
  },
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./gate": {
      "types": "./lib/gate.d.mts",
      "default": "./lib/gate.mjs"
    },
    "./tool-exec": {
      "types": "./lib/tool-exec.d.mts",
      "default": "./lib/tool-exec.mjs"
    },
    "./tool-plan": {
      "types": "./lib/tool-plan.d.mts",
      "default": "./lib/tool-plan.mjs"
    },
    "./tool-web": {
      "types": "./lib/tool-web.d.mts",
      "default": "./lib/tool-web.mjs"
    },
    "./openai-web-provider": {
      "types": "./lib/openai-web-provider.d.mts",
      "default": "./lib/openai-web-provider.mjs"
    },
    "./apply-patch": {
      "types": "./lib/apply-patch.d.mts",
      "default": "./lib/apply-patch.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-sandbox": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-shell": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-user-approval": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.0.1-rc.1 <0.2.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-ui-tool": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true },
    "@deepseek-ai/dsh-fs": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-sandbox": { "optional": true },
    "@deepseek-ai/dsh-sandbox-policy": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-shell": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
